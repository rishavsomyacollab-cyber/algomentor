# ── Claude API (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── PostgreSQL (required) ──────────────────────────────────────────────────────
# Railway provides this automatically when you add a Postgres plugin.
# Neon/Supabase: copy the connection string from their dashboard.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT Auth (required) ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here

# ── CORS (required for production) ────────────────────────────────────────────
# Add your Vercel frontend URL (comma-separated if multiple)
ALLOWED_ORIGINS=https://algomentor.vercel.app

# ── Qdrant (optional — skips vector search if not set) ────────────────────────
# Qdrant Cloud: create a free cluster at cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Neo4j (optional — graph features fall back to static edges if not set) ────
# Neo4j Aura: create a free instance at console.neo4j.io
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Ollama (local dev only — not needed in production with Claude API) ─────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
